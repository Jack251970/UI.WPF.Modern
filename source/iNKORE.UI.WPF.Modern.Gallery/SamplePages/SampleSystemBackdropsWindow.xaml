<Window
    x:Class="iNKORE.UI.WPF.Modern.Gallery.SamplePages.SampleSystemBackdropsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:iNKORE.UI.WPF.Modern.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:iNKORE.UI.WPF.Modern.Gallery"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scrollviewer="clr-namespace:Flow.Bar.Controls.NavigationView;assembly=iNKORE.UI.WPF.Modern.Controls"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="System Backdrops Window"
    Width="800"
    Height="450"
    ui:ThemeManager.IsThemeAware="True"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:TitleBar.Height="48"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Rectangle
            x:Name="XboxContentSafeRect"
            Width="48"
            Canvas.ZIndex="0"
            Fill="{DynamicResource NavigationViewDefaultPaneBackground}"
            Visibility="Collapsed" />

        <Border
            x:Name="AppTitleBar"
            Grid.Column="1"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            VerticalAlignment="Top"
            Background="Transparent"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="137" />
                </Grid.ColumnDefinitions>
                <ikw:SimpleStackPanel
                    x:Name="AppTitle"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Image
                        Width="20"
                        Margin="-3,0,0,0"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/Assets/WpfLibrary_Minimal_64w.png" />
                    <TextBlock
                        x:Name="AppTitleText"
                        Grid.Column="1"
                        Margin="0,1,20,0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Text="{x:Static local:NavigationRootPage.GetAppTitleFromSystem}"
                        TextWrapping="NoWrap" />
                    <!--<ui:AutoSuggestBox
                        x:Name="controlsSearchBox"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        x:FieldModifier="public"
                        PlaceholderText="Search"
                        QuerySubmitted="OnControlsSearchBoxQuerySubmitted"
                        TextChanged="OnControlsSearchBoxTextChanged">
                        <ui:AutoSuggestBox.QueryIcon>
                            <ui:FontIcon
                                FontSize="12"
                                Glyph="&#xE721;"
                                RenderTransformOrigin="0.5,0.5" />
                        </ui:AutoSuggestBox.QueryIcon>
                    </ui:AutoSuggestBox>-->
                </ikw:SimpleStackPanel>
            </Grid>
        </Border>

        <scrollviewer:NavigationView
            x:Name="NavigationViewControl"
            Grid.Column="1"
            AlwaysShowHeader="True"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            Header="General"
            IsFooterSeparatorVisible="{x:Null}"
            IsTabStop="False"
            IsTitleBarAutoPaddingEnabled="False"
            Loaded="OnNavigationViewControlLoaded"
            PaneClosing="NavigationViewControl_PaneClosing"
            PaneOpening="NavigationViewControl_PaneOpening"
            PaneTitle=""
            SelectionChanged="OnNavigationViewSelectionChanged">
            <scrollviewer:NavigationView.HeaderTemplate>
                <DataTemplate>
                    <controls:PageHeader
                        Title="{Binding Header, ElementName=NavigationViewControl}"
                        Background="Transparent"
                        BackgroundColorOpacity="1" />
                </DataTemplate>
            </scrollviewer:NavigationView.HeaderTemplate>

            <scrollviewer:NavigationView.MenuItems>
                <scrollviewer:NavigationViewItem Content="General">
                    <scrollviewer:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE713;" />
                    </scrollviewer:NavigationViewItem.Icon>
                </scrollviewer:NavigationViewItem>
                <scrollviewer:NavigationViewItem Content="About">
                    <scrollviewer:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE946;" />
                    </scrollviewer:NavigationViewItem.Icon>
                </scrollviewer:NavigationViewItem>
            </scrollviewer:NavigationView.MenuItems>

            <ui:Frame
                x:Name="rootFrame"
                Navigated="OnRootFrameNavigated"
                Navigating="OnRootFrameNavigating" />
        </scrollviewer:NavigationView>
    </Grid>
</Window>