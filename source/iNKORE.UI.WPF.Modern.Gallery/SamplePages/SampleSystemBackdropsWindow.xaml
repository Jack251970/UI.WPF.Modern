<Window
    x:Class="iNKORE.UI.WPF.Modern.Gallery.SamplePages.SampleSystemBackdropsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:iNKORE.UI.WPF.Modern.Gallery.SamplePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="System Backdrops Window"
    Width="800"
    Height="450"
    ui:ThemeManager.IsThemeAware="True"
    ui:ThemeManager.RequestedTheme="Default"
    ui:WindowHelper.Acrylic10Color="{DynamicResource SmokeFillColorDefault}"
    ui:WindowHelper.ApplyBackground="False"
    ui:WindowHelper.ApplyNoise="False"
    ui:WindowHelper.SystemBackdropType="Acrylic10"
    ui:WindowHelper.UseModernWindowStyle="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  #cf202020  -->
    <!--  #222222 for Taskbar because #202020 is the color of Taskbar under black solid color background  -->
    <!--  #2f2f2f for context menu #2a2a2a is the color of context menu under black solid color background  -->
    <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Text="AAA" />
</Window>